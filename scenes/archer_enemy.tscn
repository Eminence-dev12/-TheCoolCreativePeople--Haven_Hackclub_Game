[sub_resource type="GDScript" id="GDScript_3owqy"]
resource_name = "Fire"
script/source = "extends CharacterBody2D
@onready var vision: RayCast2D = $\".\"
@onready var prince: CharacterBody2D = $\".\"
@onready var mage: CharacterBody2D = $\".\"


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if mage:
		vision.target_position = vision.to_local(mage.global_position)
		vision.force_raycast_update()
		if vision.is_colliding():
			var collider = vision.get_collider()
			if collider == mage or collider.is_in_group(\"mage\"):
				print(\"player spotted\")
	elif prince:
		vision.target_position = vision.to_local(prince.global_position)
		vision.force_raycast_update()
		if vision.is_colliding():
			var collider = vision.get_collider()
			if collider == prince or collider.is_in_group(\"prince\"):
				print(\"player spotted\")
"

