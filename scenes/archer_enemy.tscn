[sub_resource type="GDScript" id="GDScript_3owqy"]
resource_name = "Fire"
script/source = "extends CharacterBody2D
const ArrowScene := preload(\"res://scripts/arrow.tscn\")

@onready var vision: RayCast2D = $vision
@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
var vision_range: float
var player_target: Vector2

func _ready() -> void:
	vision_range = vision.target_position.length()
	sprite.animation_finished.connect(_on_animation_finished)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	var player := get_parent().get_node_or_null(\"Mage\") as CharacterBody2D
	if player == null:
		player = get_parent().get_node_or_null(\"Prince\") as CharacterBody2D
	if player == null:
		return
	var target: Vector2 = player.global_position
	var body := player.get_node_or_null(\"CollisionShape2D\") as CollisionShape2D
	if body != null:
		target = body.global_position
	player_target = target
	var direction: Vector2 = vision.to_local(target)
	vision.target_position = direction.normalized() * vision_range
	vision.force_raycast_update()
	sprite.flip_h = direction.x < 0.0
	if vision.is_colliding() and vision.get_collider() == player:
		if sprite.animation != \"fire\" or not sprite.is_playing():
			sprite.play(\"fire\")
	else:
		if sprite.animation != \"idol\":
			sprite.play(\"idol\")

func _on_animation_finished() -> void:
	if sprite.animation != \"fire\":
		return
	var arrow := ArrowScene.instantiate() as CharacterBody2D
	add_child(arrow)
	arrow.global_position = global_position
	arrow.shoot(player_target)

func _on_hurtbox_area_entered(area: Area2D) -> void:
	# Check if the object that hit the enemy is a fireball
	if area.is_in_group(\"fireball\"):
		# Destroy the fireball
		area.queue_free()
		# Destroy the enemy
		queue_free()
"

