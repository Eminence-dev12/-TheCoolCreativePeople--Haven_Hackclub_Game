resource_name = "characterSelect"
script/source = "extends Control


# Called when the node enters the scene tree for the first time.
func _ready():
	print(Global.selected_character)


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_button_5_pressed() -> void:
	Global.selected_character = 1 
	print(\"you Chose prince!\")# Replace with function body.


func _on_button_pressed() -> void:
	Global.selected_character = 2
	print(\"you choose mage\") # Replace with function body.


func _on_button_6_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scenes/main_menu.tscn\") # Replace with function body.


func _on_button_2_pressed() -> void:
	Global.selected_character = 3 # Replace with function body.


func _on_button_4_pressed() -> void:
	Global.selected_character = 4 # Replace with function body.
"

